# Streamlit OAuth & Advisory SMTP Secrets Configuration Example
# Copy this file to '.streamlit/secrets.toml' and replace the placeholder values with your real credentials.

# -----------------------------------------------------------------------------
# 1. Google OAuth 2.0 (OIDC) Configuration
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:8501/oauth2callback
# -----------------------------------------------------------------------------
[auth.google]
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }

# -----------------------------------------------------------------------------
# 2. Microsoft Entra ID (Azure AD) OAuth Configuration
# Register an application in Microsoft Entra ID (Azure Portal) -> App registrations
# Authorized Redirect URI: http://localhost:8501/oauth2callback
# -----------------------------------------------------------------------------
[auth.microsoft]
client_id = "YOUR_MICROSOFT_CLIENT_ID"
client_secret = "YOUR_MICROSOFT_CLIENT_SECRET"
server_metadata_url = "https://login.microsoftonline.com/common/v2.0/.well-known/openid-configuration"
client_kwargs = { prompt = "select_account" }

# -----------------------------------------------------------------------------
# 3. SMTP Email Configuration (Gmail)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# -----------------------------------------------------------------------------
[email]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender_email = "your-email@gmail.com"
app_password = "your-16-char-app-password"
